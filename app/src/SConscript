import os
from building import *

Import('RTT_ROOT')
Import('rtconfig')

cwd = GetCurrentDir()
src = ['main.c']

CPPPATH = [cwd]

group = DefineGroup('App_utils', src, depend = [''], CPPPATH = CPPPATH)

group = group + SConscript(os.path.join(cwd, 'xiaozhi', 'SConscript'),
                           variant_dir = os.path.join(rtconfig.OUTPUT_DIR, 'src', 'xiaozhi'),
                           duplicate = 0)

group = group + SConscript(os.path.join(cwd, 'xiaozhi', 'board', 'SConscript'),
                           variant_dir = os.path.join(rtconfig.OUTPUT_DIR, 'src', 'xiaozhi', 'board'),
                           duplicate = 0)

Return('group')
