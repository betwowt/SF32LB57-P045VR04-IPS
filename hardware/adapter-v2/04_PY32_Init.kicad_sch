		(exclude_from_sim no)
		(at 15.24 15.24 0)
		(effects
			(font
				(size 2.032 2.032)
			)
			(justify left top)
		)
		(uuid "8785976d-6479-596b-a920-24790e03c532")
	)
	(text "SWD PROGRAMMING"
		(exclude_from_sim no)
		(at 20.32 168.91 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left top)
		)
		(uuid "c43e4ab4-6175-5017-b992-66a2089e7004")
	)
	(text "FIRMWARE SEQUENCE\n1. READY=0; CS=1; clock at panel idle level.\n2. Wait for power, then reset the panel.\n3. Send the panel-specific 8/9-bit SPI table.\n4. Wait all required delays, then set READY=1.\n5. H743 waits for PG3 before backlight enable.\n\nFive panels share two connector pinout families.\nThis project contains hardware only."
		(exclude_from_sim no)
		(at 312.42 93.98 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "cebe9b94-9735-50b6-a929-64e1334bc589")
	)
