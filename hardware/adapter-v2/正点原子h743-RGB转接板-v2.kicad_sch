		(uuid "4009bec1-2893-5e56-8406-cc4980fd321e")
	)
	(text "RGB565: R3..R7, G2..G7, B3..B7\nLCD lower bits R0..2/G0..1/B0..2 are held LOW.\nNo RGB888 or missing-bit reconstruction is implied."
		(exclude_from_sim no)
		(at 15.24 139.7 0)
		(effects
